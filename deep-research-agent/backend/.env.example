# ===== Application =====
APP_NAME=deep-research-agent
ENVIRONMENT=development
DEBUG=true

# Comma-separated browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# ===== Databases / Infrastructure =====
# PostgreSQL DSN (source of truth for jobs/tasks/sources/evidence/report).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/deep_research
# Redis DSN (transient job queue/lease transport).
REDIS_URL=redis://localhost:6379/0

# ===== Test isolation (optional) =====
# When unset, the test suite derives <DATABASE_NAME>_test and Redis db 15 from the
# URLs above so tests never touch the development database/keys.
TEST_DATABASE_URL=
TEST_REDIS_URL=

# Apply Alembic migrations automatically at API/worker startup (idempotent).
RUN_MIGRATIONS_ON_STARTUP=true

# ===== Vector DB =====
VECTOR_DB_URL=

# ===== Object / Blob storage =====
# S3-compatible object storage (Supabase Storage, Vercel Blob, Cloudflare R2, AWS S3).
# Leave OBJECT_STORAGE_ENDPOINT empty to store uploads on the local filesystem
# (development only — files are lost when the container is redeployed on a PaaS).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Signature-v4 region (us-east-1 works for Supabase Storage / Vercel Blob; R2 uses "auto").
OBJECT_STORAGE_REGION=us-east-1
# Path-style addressing is required by Supabase, Vercel Blob, and R2 (AWS S3 can use false).
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# ===== LLM =====
# Provider selection and model. Leave LLM_MODEL empty to use the provider default.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_TIMEOUT=60
# Optional custom base URL (e.g. self-hosted/OpenAI-compatible gateways).
OPENAI_BASE_URL=

# ===== LLM provider API keys (never commit real values) =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ===== Search (V1: SerpApi) =====
# Provider identifier: "serpapi" (default) or "serper". Leave empty to disable external search.
SEARCH_PROVIDER=serpapi
SEARCH_API_KEY=
# SerpApi Google endpoint (override only if self-hosting).
SEARCH_ENDPOINT=https://serpapi.com/search.json

# ===== Research tool limits =====
MAX_SEARCH_QUERIES_PER_TASK=2
MAX_PAGES_PER_TASK=3
MAX_EVIDENCE_PER_TASK=4
MAX_PAGE_CONTENT_LENGTH=200000

# ===== Async research execution (Redis + worker) =====
# Redis list used as the job transport (job ids only; PostgreSQL is source of truth).
RESEARCH_QUEUE_NAME=research:queue
# Whole-job retries after a failed attempt (final state = failed when exhausted).
RESEARCH_WORKER_MAX_RETRIES=2
# Worker BLPOP wait in seconds (bounded blocking wait).
RESEARCH_WORKER_POLL_TIMEOUT=1.0
# Lease TTL for a running job; expired leases are reclaimed by reconciliation.
RESEARCH_JOB_LEASE_TIMEOUT=90
# How often the worker sweeps the outbox + stale jobs (seconds).
RESEARCH_OUTBOX_SWEEP_INTERVAL=10

# ===== Long-term user memory =====
# Memory is context/personalization only — it is never evidence or a citation.
# Set to false to disable memory without affecting research execution.
MEMORY_ENABLED=true
# Max relevant memories injected into the planner as user context.
MEMORY_MAX_RESULTS=5