# syntax=docker/dockerfile:1
#
# Frontend build context = repository root (the parent folder containing deep-research-agent/).
FROM node:20-alpine AS frontend

# The browser-visible backend API base. Passed at BUILD time because Next.js
# inlines NEXT_PUBLIC_* values into the bundle. Defaults to a local-backend URL.
ARG NEXT_PUBLIC_API_URL=http://localhost:8000/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

# Install dependencies first for better layer caching.
COPY deep-research-agent/frontend/package.json deep-research-agent/frontend/package-lock.json ./
# npm install needs a name/version — keep the lockfile install deterministic.
RUN npm install

COPY deep-research-agent/frontend/ ./
# Provide the public env for `npm run build` even when no .env.local exists.
COPY deep-research-agent/frontend/.env.example ./.env.local

ENV PORT=3000
EXPOSE 3000

RUN npm run build

# Serve the optimized build.
CMD ["npm", "run", "start"]