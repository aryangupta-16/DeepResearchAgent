# syntax=docker/dockerfile:1

# Background worker image (shares the same codebase as the API process).
# Build context = repository root (the parent folder containing deep-research-agent/).
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS worker

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY deep-research-agent/backend/pyproject.toml deep-research-agent/backend/uv.lock ./
COPY deep-research-agent/backend/src ./src
RUN uv sync --no-dev --frozen

# Alembic schema + migration scripts (the worker applies them at startup too).
COPY deep-research-agent/backend/alembic.ini ./
COPY deep-research-agent/backend/migrations ./migrations

CMD ["uv", "run", "python", "-m", "app.infrastructure.queue.workers"]